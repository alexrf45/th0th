{
  "enabledPlugins": {
    "antigravity-awesome-skills@antigravity-awesome-skills": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ $CLAUDE_FILE_PATH == *.yaml ]]; then yamllint $CLAUDE_FILE_PATH; fi"
          }
        ]
      }
    ]
  }
}
