env               = "dev"
bootstrap_cluster = true

talos = {
  name     = "abydos"
  endpoint = "10.30.0.120" # CP node 1 IP on the vtalos subnet (bootstrap + kubeconfig endpoint)
  vip_ip   = "10.30.0.119" # floating control-plane VIP (must be inside cilium_config.node_network)
  version  = "v1.12.8"
  platform = "nocloud"
  control_plane_extensions = [
    "intel-ucode",
    "glibc",
    "iscsi-tools",
    "util-linux-tools",
    "qemu-guest-agent",
    "i915",
    "tailscale"
  ]
  worker_extensions = [
    "intel-ucode",
    "glibc",
    "iscsi-tools",
    "util-linux-tools",
    "qemu-guest-agent",
    "i915"
  ]
}

# pve.endpoint stays on the management LAN — Terraform talks to the PVE API there.
# bridge/gateway move onto the EVPN SDN vnet (terraform/proxmox-base): VMs attach to
# `vtalos` and use the anycast gateway 10.30.0.1. Node names must match proxmox-base pve.hosts.
pve = {
  hosts    = ["pve01", "pve02", "pve03", "pve04", "pve05", "pve06"]
  endpoint = "192.168.20.6"
  bridge   = "vtalos"
  gateway  = "10.30.0.1"
  password = "" # Set via TF_VAR_pve or .env
}

nameservers = {
  primary   = "1.1.1.1"
  secondary = "8.8.8.8"
  internal  = "192.168.20.1" # resolver for *.th0th.dev (split-horizon); reached via exit-node SNAT
}

controlplane_nodes = {
  "1" = {
    node             = "pve01"
    ip               = "10.30.0.120"
    allow_scheduling = false
    storage_id       = "data"
    cores            = 2
    memory           = 8192
    disk_size        = 50
    storage_size     = 50
  }
  "2" = {
    node             = "pve02"
    ip               = "10.30.0.121"
    allow_scheduling = false
    storage_id       = "data"
    cores            = 2
    memory           = 8192
    disk_size        = 50
    storage_size     = 100
  }
  "3" = {
    node             = "pve03"
    ip               = "10.30.0.122"
    allow_scheduling = false
    storage_id       = "data"
    cores            = 2
    memory           = 8192
    disk_size        = 50
    storage_size     = 100
  }
}

worker_nodes = {
  "4" = {
    node         = "pve04"
    ip           = "10.30.0.123"
    storage_id   = "data"
    cores        = 2
    memory       = 8192
    disk_size    = 50
    storage_size = 100
  }
  "5" = {
    node         = "pve05"
    ip           = "10.30.0.124"
    storage_id   = "data"
    cores        = 2
    memory       = 8192
    disk_size    = 50
    storage_size = 100
  }
  "6" = {
    node         = "pve06"
    ip           = "10.30.0.125"
    storage_id   = "data"
    cores        = 2
    memory       = 8192
    disk_size    = 50
    storage_size = 200
  }
}

cilium_config = {
  node_network               = "10.30.0.0/24"
  kube_version               = "1.35.0"
  cilium_version             = "1.19.4"
  hubble_enabled             = false
  hubble_ui_enabled          = false
  relay_enabled              = false
  relay_pods_rollout         = false
  ingress_controller_enabled = true
  ingress_default_controller = true
  gateway_api_enabled        = true
  load_balancer_mode         = "shared"
  load_balancer_ip           = "10.30.0.200"
  load_balancer_start        = 200
  load_balancer_stop         = 215
}

# Export kubeconfig + talosconfig to 1Password (items: <cluster>-kubeconfig / <cluster>-talosconfig)
config_export = {
  enabled = true
}

worker_labels = {
  enabled = true
  labels = {
    "node-role.kubernetes.io/worker" = "true"
    "node"                           = "worker"
  }
}

flux_config = {
  enabled           = true
  git_url           = "ssh://git@github.com/alexrf45/th0th.git"
  cluster_path      = "clusters/abydos"
  branch            = "main"
  cluster_domain    = "cluster.local"
  sops_secret_name  = "sops-age"
  sops_age_key_name = "flux-staging.agekey"
}
